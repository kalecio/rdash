{
  "name": "rdash",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "cms:types": "payload generate:types",
    "cms:importmap": "payload generate:importmap",
    "cms:seed": "tsx scripts/seed.ts",
    "cms:migrate": "payload migrate",
    "cms:migrate:create": "payload migrate:create",
    "test:cms": "node --import tsx --test --test-force-exit tests/*.test.ts",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0 --no-open --disable-telemetry",
    "build-storybook": "storybook build --disable-telemetry",
    "test:unit": "vitest run",
    "test": "node node_modules/vitest/vitest.mjs run && node --import tsx --test --test-force-exit tests/*.test.ts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/db-sqlite": "3.92.1",
    "@payloadcms/email-nodemailer": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "graphql": "^16.14.2",
    "libsql": "0.4.7",
    "next": "16.3.3",
    "payload": "3.92.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@next/env": "16.3.3",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "jsdom": "^30.1.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "type": "module"
}
