# Cadastre estes valores em Environment variables da Stack no Portainer.
PAYLOAD_SECRET=change-to-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=use-a-unique-database-password
# A senha na URL deve estar codificada para URL se contiver caracteres especiais.
DATABASE_URL=postgresql://rdash:use-a-unique-database-password@db:5432/rdash
NEXT_PUBLIC_SERVER_URL=https://seu-dominio.example
APP_PORT=3000
STORYBOOK_PORT=6006

# SMTP é opcional; configure se precisar enviar e-mails de recuperação de senha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SECURE=false
